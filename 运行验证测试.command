#!/bin/bash
# ==============================================================================
# 运行验证测试.command - 双击或命令行执行全套构建与验证测试
# 包含: 源码一致性、Release 构建、--self-test、--ui-smoke、--visual-test
# 严格规则: 错误退出码真实保留，绝不吞错
# ==============================================================================

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

echo "================================================================="
echo "准备执行 Lexi macOS 自动化验证与测试套件..."
echo "================================================================="

set +e
bash "$DIR/scripts/run_tests.sh" "$@"
EXIT_CODE=$?
set -e

# 如果是 Finder 双击启动的交互式终端，提示按键后再关闭窗口
if [ -t 0 ] && [ -n "$TERM" ] && [ -z "$NONINTERACTIVE" ]; then
    echo ""
    read -r -p "测试执行结束 (综合退出码: $EXIT_CODE)。按回车键退出..." dummy </dev/tty || true
fi

exit $EXIT_CODE
