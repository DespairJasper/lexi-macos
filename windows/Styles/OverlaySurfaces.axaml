<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GlassSurfaceBrush">#C8F6F9FD</SolidColorBrush>
          <SolidColorBrush x:Key="GlassEdgeBrush">#B8FFFFFF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="GlassSurfaceBrush">#D0202C3D</SolidColorBrush>
          <SolidColorBrush x:Key="GlassEdgeBrush">#554F6480</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button.audio-action">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.audio-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}"/>
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGreen}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector=":is(MenuItem)">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style Selector=":is(MenuItem) :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector=":is(MenuItem):disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="TextBox.spelling-input">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="FontSize" Value="26"/>
  </Style>
  <Style Selector="TextBox.spelling-input /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="TextBox.spelling-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGreen}"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
</Styles>
